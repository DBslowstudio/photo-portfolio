---
import { getCollection, getImage, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('photos');
  // 排序规则必须和首页网格一致（按拍摄日期倒序），
  // 否则「上一张 / 下一张」的跳转顺序会和用户浏览顺序对不上。
  const ordered = [...entries].sort((a, b) =>
    (b.data.date ?? '').localeCompare(a.data.date ?? ''),
  );
  return ordered.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, ordered, currentIndex: index },
  }));
}

interface Props {
  entry: CollectionEntry<'photos'>;
  ordered: CollectionEntry<'photos'>[];
  currentIndex: number;
}

const { entry, ordered, currentIndex } = Astro.props;
const photo = entry.data;

const prevPhoto = currentIndex > 0 ? ordered[currentIndex - 1] : null;
const nextPhoto =
  currentIndex < ordered.length - 1 ? ordered[currentIndex + 1] : null;

// 动态获取当前主图的真实尺寸，用于页面布局
const mainImage = await getImage({ src: photo.image });

// 为灯箱准备数据：动态获取每张图片的真实尺寸，彻底解决写死尺寸导致的黑屏问题
const lightboxItems = await Promise.all(
  ordered.map(async (p) => {
    const img = await getImage({ src: p.data.image });
    return {
      src: img.src,
      width: img.attributes.width,
      height: img.attributes.height,
      alt: p.data.title,
      title: p.data.title,
    };
  })
);

const exifRows: Array<{ label: string; value?: string }> = [
  { label: '相机', value: photo.exif?.camera },
  { label: '镜头', value: photo.exif?.lens },
  { label: '焦距', value: photo.exif?.focalLength },
  { label: '光圈', value: photo.exif?.aperture },
  { label: '快门', value: photo.exif?.shutterSpeed },
  { label: '感光度', value: photo.exif?.iso },
];

const hasExif = exifRows.some((row) => row.value);
---

<Layout
  title={`${photo.title} - SLOW 慢驶摄影画廊`}
  description={photo.description || photo.title}
>
  <!-- 顶部占位，避免固定导航盖住内容 -->
  <div class="h-24"></div>

  <article class="max-w-6xl mx-auto px-6 pb-24">
    <!-- 主图 + 侧栏（大屏并排，小屏堆叠） -->
    <div>
      <!-- 主图：点击打开 PhotoSwipe 灯箱 -->
      <figure class="relative bg-dark-800 overflow-hidden group">
        <button
          id="lightbox-trigger"
          type="button"
          class="block w-full cursor-zoom-in"
          aria-label={`放大查看 ${photo.title}`}
        >
          <img
            src={mainImage.src}
            alt={photo.title}
            width={mainImage.attributes.width}
            height={mainImage.attributes.height}
            class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-[1.02]"
          />
        </button>
        <figcaption
          class="absolute bottom-0 left-0 right-0 p-5 bg-gradient-to-t from-black/80 to-transparent pointer-events-none"
        >
          <p class="text-gray-300 text-xs tracking-widest uppercase">
            点击图片放大查看
          </p>
        </figcaption>
      </figure>
    </div>

    <!-- 标题与描述 -->
    <header class="mt-12">
      <h1 class="text-4xl md:text-5xl font-light tracking-wide text-white">
        {photo.title}
      </h1>
      {
        photo.location && (
          <p class="text-gray-400 mt-3 tracking-wide">
            {photo.location}
            {photo.date && ` · ${photo.date}`}
          </p>
        )
      }
      {
        !photo.location && photo.date && (
          <p class="text-gray-400 mt-3 tracking-wide">{photo.date}</p>
        )
      }
      {
        photo.description && (
          <p class="text-gray-300 mt-6 max-w-2xl leading-relaxed">
            {photo.description}
          </p>
        )
      }
    </header>

    <!-- 拍摄参数：无数据时整块不渲染，不留空标题 -->
    {
      hasExif && (
        <section class="mt-14 border-t border-dark-700 pt-10">
          <h2 class="text-sm tracking-widest uppercase text-gray-500 mb-6">
            拍摄参数
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
            {exifRows.map(
              (row) =>
                row.value && (
                  <div>
                    <p class="text-gray-500 text-xs uppercase tracking-wider">
                      {row.label}
                    </p>
                    <p class="text-gray-200 mt-1">{row.value}</p>
                  </div>
                ),
            )}
          </div>
          <p class="text-gray-600 text-xs mt-6">
            参数由图片 EXIF 自动提取。
          </p>
        </section>
      )
    }

    <!-- 上一张 / 下一张 -->
    <nav
      class="mt-16 border-t border-dark-700 pt-10 flex items-center justify-between gap-4"
    >
      {
        prevPhoto ? (
          <a href={`/photos/${prevPhoto.id}`} class="group text-left">
            <span class="text-gray-500 text-xs tracking-widest uppercase block">
              上一张
            </span>
            <span class="text-gray-200 group-hover:text-white transition-colors mt-1 block">
              ← {prevPhoto.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      <a
        href="/"
        class="nav-link shrink-0 border border-dark-600 px-6 py-2 hover:border-white/40"
      >
        返回作品
      </a>
      {
        nextPhoto ? (
          <a href={`/photos/${nextPhoto.id}`} class="group text-right">
            <span class="text-gray-500 text-xs tracking-widest uppercase block">
              下一张
            </span>
            <span class="text-gray-200 group-hover:text-white transition-colors mt-1 block">
              {nextPhoto.data.title} →
            </span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  <!--
    PhotoSwipe 数据通过 JSON script 标签传递。
    不用 define:vars，因为 define:vars 会让 Astro 放弃对脚本做打包，
    import 'photoswipe/lightbox' 就会失效。
  -->
  <script
    is:inline
    type="application/json"
    id="lightbox-data"
    set:html={JSON.stringify({
      items: lightboxItems,
      startIndex: currentIndex,
    })}
  ></script>

  <script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';

    const dataEl = document.getElementById('lightbox-data');
    const trigger = document.getElementById('lightbox-trigger');

    if (dataEl && trigger && dataEl.textContent) {
      const { items, startIndex } = JSON.parse(dataEl.textContent) as {
        items: Array<{
          src: string;
          width: number;
          height: number;
          alt: string;
          title: string;
        }>;
        startIndex: number;
      };

      const lightbox = new PhotoSwipeLightbox({
        dataSource: items,
        pswpModule: () => import('photoswipe'),
        showHideAnimationType: 'zoom',
        bgOpacity: 0.94,
        padding: { top: 32, bottom: 32, left: 24, right: 24 },
      });

      // 灯箱底部显示当前照片标题
      lightbox.on('uiRegister', () => {
        lightbox.pswp?.ui?.registerElement({
          name: 'photoCaption',
          className: 'pswp__photo-caption',
          appendTo: 'wrapper',
          onInit: (el, pswp) => {
            const render = () => {
              const data = pswp.currSlide?.data as

                | { title?: string }
                | undefined;
              el.textContent = data?.title ?? '';
            };
            render();
            pswp.on('change', render);
          },
        });
      });

      lightbox.init();

      // 主图手动触发灯箱
      trigger.addEventListener('click', () => {
        lightbox.loadAndOpen(startIndex);
      });
    }
  </script>

  <style is:global>
    .pswp__photo-caption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 14px 18px;
      font-size: 14px;
      letter-spacing: 0.08em;
      color: #d4d4d4;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
      text-align: center;
      pointer-events: none;
    }
  </style>
</Layout>