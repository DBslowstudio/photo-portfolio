---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('photos');
  // 详情页按拍摄日期倒序，保证「上一张/下一张」浏览顺序连贯
  const ordered = [...entries].sort((a, b) =>
    (b.data.date ?? '').localeCompare(a.data.date ?? ''),
  );
  return ordered.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, ordered, currentIndex: index },
  }));
}

interface Props {
  entry: CollectionEntry<'photos'>;
  ordered: CollectionEntry<'photos'>[];
  currentIndex: number;
}

const { entry, ordered, currentIndex } = Astro.props;
const photo = entry.data;

const prevPhoto = currentIndex > 0 ? ordered[currentIndex - 1] : null;
const nextPhoto =
  currentIndex < ordered.length - 1 ? ordered[currentIndex + 1] : null;

// 确保图片路径是完整 URL（Vercel 部署后相对路径可能解析失败导致黑屏）
const BASE_URL = import.meta.env.BASE_URL || '/';
const ensureAbsUrl = (p) => {
  if (p.startsWith('http') || p.startsWith('//')) return p;
  // 去掉开头的 / 避免路径重复
  const cleanPath = p.charAt(0) === '/' ? p.slice(1) : p;
  return BASE_URL + cleanPath;
};

// 灯箱数据（先给占位尺寸，客户端会替换为真实尺寸）
const lightboxItems = ordered.map((p) => ({
  src: ensureAbsUrl(p.data.image),
  width: 1600,
  height: 1200,
  alt: p.data.title,
  title: p.data.title,
}));

const exifRows = [
  { label: '相机', value: photo.exif?.camera },
  { label: '镜头', value: photo.exif?.lens },
  { label: '焦距', value: photo.exif?.focalLength },
  { label: '光圈', value: photo.exif?.aperture },
  { label: '快门', value: photo.exif?.shutterSpeed },
  { label: '感光度', value: photo.exif?.iso },
];

const hasExif = exifRows.some((row) => row.value);
---

<Layout
  title={`${photo.title} - SLOW 慢驶摄影画廊`}
  description={photo.description || photo.title}
>
  <!-- 顶部占位，避免固定导航盖住内容 -->
  <div class="h-24"></div>

  <article class="max-w-6xl mx-auto px-6 pb-24">
    <!-- 主图 + 侧栏（大屏并排，小屏堆叠） -->
    <div>
      <!-- 主图：点击打开 PhotoSwipe 灯箱 -->
      <!-- 修复：容器加 max-h-[85vh] 限制高度，flex 居中；图片用 object-contain 保证不裁切、不溢出 -->
       <figure class="relative overflow-hidden group max-h-[85vh] flex items-center justify-center">
        <button
          id="lightbox-trigger"
          type="button"
          class="block cursor-zoom-in"
          aria-label={`放大查看 ${photo.title}`}
        >
          <img
            src={photo.image}
            alt={photo.title}
            class="max-w-full max-h-[80vh] object-contain transition-transform duration-700 group-hover:scale-[1.02]"
          />
        </button>
        <figcaption
          class="absolute bottom-0 left-0 right-0 p-5 bg-gradient-to-t from-black/80 to-transparent pointer-events-none"
        >
          <p class="text-gray-300 text-xs tracking-widest uppercase">
            点击图片放大查看
          </p>
        </figcaption>
      </figure>
    </div>

    <!-- 标题与描述 -->
    <header class="mt-12">
      <h1 class="text-4xl md:text-5xl font-light tracking-wide text-white">
        {photo.title}
      </h1>
      {
        photo.location && (
          <p class="text-gray-400 mt-3 tracking-wide">
            {photo.location}
            {photo.date && ` · ${photo.date}`}
          </p>
        )
      }
      {
        !photo.location && photo.date && (
          <p class="text-gray-400 mt-3 tracking-wide">{photo.date}</p>
        )
      }
      {
        photo.description && (
          <p class="text-gray-300 mt-6 max-w-2xl leading-relaxed">
            {photo.description}
          </p>
        )
      }
    </header>

    <!-- 拍摄参数：无数据时整块不渲染，不留空标题 -->
    {
      hasExif && (
        <section class="mt-14 border-t border-dark-700 pt-10">
          <h2 class="text-sm tracking-widest uppercase text-gray-500 mb-6">
            拍摄参数
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
            {exifRows.map(
              (row) =>
                row.value && (
                  <div>
                    <p class="text-gray-500 text-xs uppercase tracking-wider">
                      {row.label}
                    </p>
                    <p class="text-gray-200 mt-1">{row.value}</p>
                  </div>
                ),
            )}
          </div>
          <p class="text-gray-600 text-xs mt-6">
            参数由图片 EXIF 自动提取。
          </p>
        </section>
      )
    }

    <!-- 上一张 / 下一张 -->
    <nav
      class="mt-16 border-t border-dark-700 pt-10 flex items-center justify-between gap-4"
    >
      {
        prevPhoto ? (
          <a href={`/photos/${prevPhoto.id}`} class="group text-left">
            <span class="text-gray-500 text-xs tracking-widest uppercase block">
              上一张
            </span>
            <span class="text-gray-200 group-hover:text-white transition-colors mt-1 block">
              ← {prevPhoto.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      <a
        href="/"
        class="nav-link shrink-0 border border-dark-600 px-6 py-2 hover:border-white/40"
      >
        返回作品
      </a>
      {
        nextPhoto ? (
          <a href={`/photos/${nextPhoto.id}`} class="group text-right">
            <span class="text-gray-500 text-xs tracking-widest uppercase block">
              下一张
            </span>
            <span class="text-gray-200 group-hover:text-white transition-colors mt-1 block">
              {nextPhoto.data.title} →
            </span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  <!--
    PhotoSwipe 数据通过 JSON script 标签传递。
    注意：这里的 width/height 只是占位值，真正的真实尺寸会在客户端 JS 中动态加载图片后替换。
  -->
  <script
    is:inline
    type="application/json"
    id="lightbox-data"
    set:html={JSON.stringify({
      items: lightboxItems,
      startIndex: currentIndex,
    })}
  ></script>

  <script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';

    (async () => {
      const dataEl = document.getElementById('lightbox-data');
      const trigger = document.getElementById('lightbox-trigger');

      if (dataEl && trigger && dataEl.textContent) {
        const parsed = JSON.parse(dataEl.textContent);
        const rawItems = parsed.items;
        const startIndex = parsed.startIndex;

        // 核心修复：在客户端动态加载每张图片，获取真实宽高
        // 这样 PhotoSwipe 拿到的就是正确的横/竖比例，不会再压扁
        const items = await Promise.all(
          rawItems.map((item) => {
            return new Promise((resolve) => {
              const img = new Image();
              img.onload = () => {
                resolve({
                  ...item,
                  width: img.naturalWidth,
                  height: img.naturalHeight,
                });
              };
              img.onerror = () => {
                // 图片加载失败时 fallback 到竖图比例
                resolve({ ...item, width: 1200, height: 1600 });
              };
              img.src = item.src;
            });
          })
        );

        const lightbox = new PhotoSwipeLightbox({
          dataSource: items,
          pswpModule: () => import('photoswipe'),
          showHideAnimationType: 'zoom',
          bgOpacity: 0.94,
          padding: { top: 32, bottom: 32, left: 24, right: 24 },
          // 使用 fit 模式：图片自动适配视口，横图横显竖图竖显
          initialZoomLevel: 'fit',
          secondaryZoomLevel: 2,
          maxZoomLevel: 4,
        });

        // 灯箱底部显示当前照片标题
        lightbox.on('uiRegister', () => {
          lightbox.pswp?.ui?.registerElement({
            name: 'photoCaption',
            className: 'pswp__photo-caption',
            appendTo: 'wrapper',
            onInit: (el, pswp) => {
              const render = () => {
                const data = pswp.currSlide?.data;
                el.textContent = data ? (data.title || '') : '';
              };
              render();
              pswp.on('change', render);
            },
          });
        });

        lightbox.init();

        // 主图手动触发灯箱
        trigger.addEventListener('click', () => {
          lightbox.loadAndOpen(startIndex);
        });
      }
    })();
  </script>

  <style is:global>
    .pswp__photo-caption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 14px 18px;
      font-size: 14px;
      letter-spacing: 0.08em;
      color: #d4d4d4;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
      text-align: center;
      pointer-events: none;
    }
  </style>
</Layout>