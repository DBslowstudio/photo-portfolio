---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

/**
 * 专题暗室页 —— 2.0 轨道二的观展体验。
 *
 * 设计约束（来自需求清单，全部落实在下方代码）：
 * - 全屏沉浸：纯黑背景、照片居中、大量留白；本页面不套全站 Header/Footer，
 *   用独立极简壳（仅左上角一个退出链接），避免导航条破坏暗室感
 * - 照片按展线顺序逐张浏览，切换用克制的淡入淡出
 * - 键盘 ←/→ 翻页；手机左右滑动翻页
 * - 标题与地点悬停（桌面）/长按（手机）才出现，平时不打扰观看
 * - 不自动播放、无弹窗
 *
 * 数据契约：展线引用 src/content/photos 的 slug；引用到不存在的 slug 时
 * 跳过该项而不是报错（后台填错一个文件名不应让线上 500）。
 */
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;

// 索引用于补 EXIF 展示（focalLength/aperture 等），与碎片区同源
let indexBySlug = new Map();
try {
  const idxFile = path.join(process.cwd(), 'src', 'data', 'photos-index.json');
  for (const it of JSON.parse(fs.readFileSync(idxFile, 'utf8'))) {
    indexBySlug.set(it.slug, it);
  }
} catch {
  /* 索引缺失时元数据条留空，不阻塞渲染 */
}

const allPhotos = await getCollection('photos');
const photoById = new Map(
  allPhotos.map((x) => [x.id.replace(/\.(mdx?|md)$/, ''), x]),
);

const slides = [];
const seen = new Set();
// 归一化：旧格式 p-016、新格式（缩略图选择器）/photos/p-016.jpg，统一成 mdx 条目键
const normKey = (ref) =>
  String(ref)
    .replace(/^\/?photos\//, '')
    .replace(/\.(mdx?|md|jpe?g|png|webp)$/i, '');
for (const ref of project.data.photos || []) {
  const key = normKey(ref);
  if (seen.has(key)) continue;
  seen.add(key);
  const entry = photoById.get(key);
  if (!entry) continue; // 引用失效：跳过而非失败
  const idx = indexBySlug.get(key) || {};
  slides.push({
    src: entry.data.image || `/photos/${key}`,
    title: entry.data.title || '',
    location: entry.data.location || idx.location || '',
    meta: [idx.focalLength, idx.aperture].filter(Boolean).join(' · '),
    year: idx.year || (entry.data.date ? String(entry.data.date).slice(0, 4) : ''),
    desc: entry.data.description || '',
  });
}

const nav = (await getCollection('projects'))
  .sort((a, b) => String(b.data.date || '').localeCompare(String(a.data.date || '')))
  .map((p) => ({ id: p.id, title: p.data.title }));
const cur = nav.findIndex((n) => n.id === project.id);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{project.data.title} - 专题 - SLOW 慢驶</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="darkroom">
    <header class="dr-top">
      <a href="/projects" class="dr-exit">← 退出暗室</a>
      <div class="dr-title">{project.data.title}</div>
      <div class="dr-progress" id="dr-progress">序言 · 共 {slides.length} 张</div>
    </header>

    <main class="dr-stage" id="dr-stage" tabindex="-1" aria-label="照片浏览区，左右方向键或滑动翻页">
      {
        // 序言帧（参考站系列页体例：大图 + 中文在上、英文在下的自述）。
        // 作为第 0 帧复用键盘/滑动翻页，←回到序言、→即入展线。
        <figure class="dr-slide dr-pros" data-index={-1}>
          <div class="dr-pros-inner">
            <img
              src={(slides[0] && slides[0].src) || project.data.cover || ''}
              alt={project.data.title}
              draggable="false"
            />
            <h1 class="dr-pros-title">{project.data.title}</h1>
            {project.data.date && (
              <p class="dr-pros-date">{project.data.date}</p>
            )}
            {project.data.summary && (
              <div class="dr-pros-zh">{project.data.summary}</div>
            )}
            {project.data.summaryEn && (
              <div class="dr-pros-en">{project.data.summaryEn}</div>
            )}
            <p class="dr-pros-hint">→ 开始观展</p>
          </div>
        </figure>
      }
      {
        slides.map((s, i) => (
          <figure class="dr-slide" data-index={i} aria-hidden={i === 0 ? 'false' : 'true'}>
            <img src={s.src} alt={s.title || project.data.title} draggable="false" />
            <figcaption class:list={["dr-caption", s.desc && "has-desc"]}>
              {s.title && <div class="dr-cap-title">{s.title}</div>}
              {(s.location || s.year) && (
                <div class="dr-cap-sub">
                  {[s.location, s.year].filter(Boolean).join(' · ')}
                </div>
              )}
              {s.meta && <div class="dr-cap-meta">{s.meta}</div>}
              {s.desc && (
                <div class="dr-cap-desc">{s.desc}</div>
              )}
              {s.desc && (
                <p class="dr-cap-hint" aria-hidden="true">⌄ 滚动看配文</p>
              )}
            </figcaption>
          </figure>
        ))
      }
      {slides.length === 0 && (
        <p class="dr-empty">这个专题还没有可用的照片——后台「照片清单」里引用的名字需要在碎片区真实存在。</p>
      )}
      <!-- 纯鼠标辅助：金色箭头 + 键位提示；初始 is-off，由脚本按帧同步显隐 -->
      <button class="dr-arrow dr-arrow--prev is-off" id="dr-prev" type="button" aria-label="上一张">‹</button>
      <button class="dr-arrow dr-arrow--next is-off" id="dr-next" type="button" aria-label="下一张">›</button>
      <p class="dr-keyhint is-off" id="dr-keyhint">← → 翻页 · ↓ 或滚动看配文</p>
    </main>

    <nav class="dr-bottom">
      {
        cur > 0 && (
          <a class="dr-other" href={`/projects/${nav[cur - 1].id}`}>
            上一个专题：{nav[cur - 1].title}
          </a>
        )
      }
      {
        cur >= 0 && cur < nav.length - 1 && (
          <a class="dr-other" href={`/projects/${nav[cur + 1].id}`}>
            下一个专题：{nav[cur + 1].title}
          </a>
        )
      }
    </nav>

    <style is:global>
      /* 黑金极简 · 暗室。刻意不引全站 CSS：纯黑、零装饰、无滚动条 */
      .darkroom {
        margin: 0;
        background: #0a0a0a;
        color: #e5e5e5;
        font-family: 'Inter', 'Noto Sans SC', system-ui, sans-serif;
        height: 100dvh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }
      .dr-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px 0;
        gap: 16px;
      }
      .dr-exit {
        color: #6b7280;
        text-decoration: none;
        font-size: 13px;
        white-space: nowrap;
        transition: color 0.3s;
      }
      .dr-exit:hover { color: #c9a558; }
      .dr-title {
        font-size: 13px;
        letter-spacing: 0.08em;
        color: #9ca3af;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .dr-progress { font-size: 12px; color: #4b5563; white-space: nowrap; }

      .dr-stage {
        position: relative;
        flex: 1;
        margin: 0 5vw;
        outline: none;
      }
      .dr-slide {
        position: absolute;
        inset: 0;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.55s ease;
      }
      .dr-slide.is-active { opacity: 1; visibility: visible; }

      /* 序言帧：窄栏滚动排版，与照片帧共用翻页机制 */
      .dr-slide.dr-pros {
        align-items: flex-start;
        justify-content: center;
        overflow-y: auto;
        opacity: 0;
      }
      .dr-slide.dr-pros.is-active { opacity: 1; }
      .dr-pros-inner {
        width: min(680px, 92vw);
        margin: clamp(20px, 6vh, 60px) auto calc(30px + env(safe-area-inset-bottom));
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 22px;
      }
      .dr-pros-inner img {
        width: min(520px, 88vw);
        height: auto;
        border-radius: 2px;
      }
      .dr-pros-title {
        font-size: clamp(22px, 3.4vw, 34px);
        font-weight: 300;
        letter-spacing: 0.12em;
        color: #e5e5e5;
        margin: 6px 0 0;
      }
      .dr-pros-date {
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #6b7280;
        margin: 0;
      }
      .dr-pros-zh {
        font-size: 14px;
        line-height: 2.1;
        color: #a3a3a3;
        white-space: pre-line;
        text-align: left;
      }
      .dr-pros-en {
        font-size: 12px;
        line-height: 2;
        color: #4b5563;
        white-space: pre-line;
        text-align: left;
      }
      .dr-pros-hint {
        font-size: 11px;
        letter-spacing: 0.3em;
        color: #c9a558;
        opacity: 0.8;
        margin: 10px 0 0;
      }
      .dr-slide img {
        max-width: 100%;
        max-height: calc(100dvh - 190px);
        width: auto;
        height: auto;
        display: block;
        -webkit-user-drag: none;
        user-select: none;
      }

      /* caption 常驻：默认半隐(dim)，滚动/下滑/点击配文区后提亮展开。
         与主页 hero 的"向下滚动"同一语言：藏两行作暗示，滚动即提亮 */
      .dr-caption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 12px;
        text-align: center;
        opacity: 0.5;
        transition: opacity 0.5s ease;
        pointer-events: none;
        padding: 26px 16px 0;
        background: linear-gradient(transparent, rgba(10, 10, 10, 0.82) 55%);
      }
      .dr-slide.is-active.dr-peek .dr-caption,
      .dr-caption.is-open { opacity: 1; }
      .dr-cap-title { font-size: 14px; color: #d1d5db; }
      .dr-cap-sub { font-size: 12px; color: #6b7280; margin-top: 3px; }
      .dr-cap-meta { font-size: 11px; color: #4b5563; margin-top: 3px; letter-spacing: 0.05em; }
      /* 配文：折叠两行半隐；is-open 时放开并提亮 */
      .dr-cap-desc {
        margin: 10px auto 0;
        max-width: 560px;
        font-size: 13px;
        line-height: 1.9;
        color: #a3a3a3;
        white-space: pre-line;
        text-align: left;
        opacity: 0.55;
        transition: opacity 0.5s ease;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        pointer-events: auto;
        cursor: pointer;
      }
      .dr-caption.is-open .dr-cap-desc {
        -webkit-line-clamp: unset;
        display: block;
        overflow: visible;
        opacity: 1;
      }
      /* 呼吸下箭 hint：折叠态常驻示意"下面有内容" */
      .dr-cap-hint {
        margin: 8px 0 0;
        font-size: 10px;
        letter-spacing: 0.28em;
        color: #c9a558;
        pointer-events: auto;
        cursor: pointer;
        animation: hint-breathe 2.6s ease-in-out infinite;
      }
      .dr-caption.is-open .dr-cap-hint { display: none; }
      @keyframes hint-breathe {
        0%, 100% { opacity: 0.28; }
        50% { opacity: 0.85; }
      }
      @media (prefers-reduced-motion: reduce) {
        .dr-cap-hint { animation: none; opacity: 0.6; }
      }

      .dr-empty {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
        font-size: 14px;
        text-align: center;
        line-height: 2;
      }

      .dr-bottom {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 10px 24px calc(14px + env(safe-area-inset-bottom));
        min-height: 20px;
      }
      .dr-other {
        font-size: 12px;
        color: #4b5563;
        text-decoration: none;
        transition: color 0.3s;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 45%;
      }
      .dr-other:hover { color: #c9a558; }

      /* 纯鼠标友好：两侧金箭头（低透明度，悬停提亮）+ 右下键位提示 */
      .dr-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 30;
        background: none;
        border: none;
        color: #c9a558;
        font-size: 34px;
        line-height: 1;
        padding: 12px 16px;
        cursor: pointer;
        opacity: 0.38;
        transition: opacity 0.3s;
        user-select: none;
      }
      .dr-arrow:hover { opacity: 0.95; }
      .dr-arrow.is-off { visibility: hidden; pointer-events: none; }
      .dr-arrow--prev { left: -8px; }
      .dr-arrow--next { right: -8px; }
      .dr-keyhint {
        position: absolute;
        right: 2px;
        bottom: 10px;
        z-index: 30;
        margin: 0;
        font-size: 10px;
        letter-spacing: 0.22em;
        color: #c9a558;
        opacity: 0.45;
        pointer-events: none;
        transition: opacity 0.4s;
      }
      .dr-keyhint.is-off { opacity: 0; }

      @media (max-width: 640px) {
        /* 触屏本可滑动翻页，隐藏箭头与键位提示 */
        .dr-arrow, .dr-keyhint { display: none; }
        .dr-top { padding: 12px 14px 0; }
        .dr-title { display: none; }
        .dr-stage { margin: 0 3vw; }
        .dr-slide img { max-height: calc(100dvh - 160px); }
        /* caption 与桌面同款：半隐常驻，竖滑或点配文区展开 */
      }
    </style>

    <script is:inline>
      (() => {
        const stage = document.getElementById('dr-stage');
        if (!stage) return;
        const slides = Array.from(stage.querySelectorAll('.dr-slide'));
        const progress = document.getElementById('dr-progress');
        const prevBtn = document.getElementById('dr-prev');
        const nextBtn = document.getElementById('dr-next');
        const keyhint = document.getElementById('dr-keyhint');
        const total = slides.length;
        let cur = 0;

        // 进度写入地址栏 hash：刷新/分享回到同一张
        const fromHash = parseInt((location.hash.match(/^#(\d+)$/) || [])[1], 10);
        if (Number.isInteger(fromHash) && fromHash >= 0 && fromHash < total) cur = fromHash;

        function show(i) {
          if (!total) return;
          cur = Math.max(0, Math.min(total - 1, i));
          slides.forEach((s, k) => {
            s.classList.toggle('is-active', k === cur);
            s.setAttribute('aria-hidden', k === cur ? 'false' : 'true');
          });
          // 换帧即收起上一帧配文：每帧从半隐折叠态讲起
          stage.querySelectorAll('.dr-caption.is-open').forEach((c) => c.classList.remove('is-open'));
          if (progress) progress.textContent = cur === 0 ? `序言 · 共 ${total - 1} 张` : `照片 ${cur} / ${total - 1}`;
          // 纯鼠标辅助：序言帧（0）隐藏箭头；进入展线后显示；
          // 键位提示只在刚进展线的第一帧亮一次，随即淡出
          if (prevBtn) prevBtn.classList.toggle('is-off', cur <= 1);
          if (nextBtn) nextBtn.classList.toggle('is-off', cur === 0 || cur >= total - 1);
          if (keyhint) keyhint.classList.toggle('is-off', cur !== 1);
          history.replaceState(null, '', '#' + cur);
        }
        show(cur);

        prevBtn?.addEventListener('click', () => show(cur - 1));
        nextBtn?.addEventListener('click', () => show(cur + 1));

        // 键盘：←/→ 翻页；↓ 展开当前帧配文（再按收起），↑ 收起。
        // Home/End 保留跳首尾。
        window.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1); }
          else if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1); }
          else if (e.key === 'ArrowDown') { e.preventDefault(); toggleCaption(); }
          else if (e.key === 'ArrowUp') { e.preventDefault(); setCaption(false); }
          else if (e.key === 'Home') show(0);
          else if (e.key === 'End') show(total - 1);
        });

        // 配文展开控制：作用于当前帧的 caption（仅当它有配文时）
        function activeCaption() {
          return slides[cur]?.querySelector('.dr-caption.has-desc');
        }
        function setCaption(open) {
          const cap = activeCaption();
          if (cap) cap.classList.toggle('is-open', open);
        }
        function toggleCaption() {
          const cap = activeCaption();
          if (cap) cap.classList.toggle('is-open');
        }

        // 滚轮：下滚展开配文，上滚收起。阈值防误触；不阻断左右翻页语义
        let wheelAcc = 0, wheelTimer = null;
        stage.addEventListener('wheel', (e) => {
          const cap = activeCaption();
          if (!cap) return;
          // 已展开且滚到底部时放行正常行为（页面无滚动条，忽略即可）
          wheelAcc += e.deltaY;
          clearTimeout(wheelTimer);
          wheelTimer = setTimeout(() => { wheelAcc = 0; }, 180);
          if (wheelAcc > 42) { cap.classList.add('is-open'); wheelAcc = 0; }
          else if (wheelAcc < -42) { cap.classList.remove('is-open'); wheelAcc = 0; }
        }, { passive: true });

        // 点/按配文区（折叠态或呼吸 hint）直接展开。
        // stopPropagation 放在捕获后的目标级，避免与序言单击入展冲突。
        stage.querySelectorAll('.dr-cap-desc, .dr-cap-hint').forEach((el) => {
          el.addEventListener('click', (e) => {
            e.stopPropagation();
            const cap = el.closest('.dr-caption');
            if (cap) cap.classList.add('is-open');
          });
        });

        // 单击：序言帧（第 0 帧）上点击任意处即进入展线；
        // 触屏点按同样生效（touchend 的滑动判定阈值远大于点按，互不干扰）。
        // 照片帧不响应单击，保持"不打扰观看"。
        stage.addEventListener('click', () => {
          if (cur === 0 && total > 1) show(1);
        });

        // 触屏：左右滑动翻页；长按露出元数据
        let x0 = null, y0 = null, peekTimer = null;
        stage.addEventListener('touchstart', (e) => {
          if (e.touches.length !== 1) return;
          x0 = e.touches[0].clientX; y0 = e.touches[0].clientY;
          peekTimer = setTimeout(() => slides[cur]?.classList.add('dr-peek'), 450);
        }, { passive: true });
        stage.addEventListener('touchmove', () => {
          clearTimeout(peekTimer);
        }, { passive: true });
        stage.addEventListener('touchend', (e) => {
          clearTimeout(peekTimer);
          if (x0 === null) return;
          const dx = e.changedTouches[0].clientX - x0;
          const dy = e.changedTouches[0].clientY - y0;
          x0 = null;
          slides[cur]?.classList.remove('dr-peek');
          if (Math.abs(dx) > 44 && Math.abs(dx) > Math.abs(dy) * 1.4) {
            show(cur + (dx < 0 ? 1 : -1));
          } else if (dy < -44 && Math.abs(dy) > Math.abs(dx) * 1.4) {
            // 竖滑上推 = 桌面滚轮下滚：展开配文
            const cap = activeCaption();
            if (cap) cap.classList.add('is-open');
          }
        }, { passive: true });
      })();
    </script>
  </body>
</html>
