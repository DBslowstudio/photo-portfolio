---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

/**
 * 专题（Projects）列表页 —— 2.0 轨道二的入口。
 * 零侵入：纯新增路由，不触碰首页/关于/联系/photos 任何现有页面。
 *
 * 版式移植自美术馆图录式（xuchenguo.com Work 页）的社论行布局：
 * 每个专题一行，左列标题+缩略图条，右列自述，发丝线分隔，
 * 悬停仅一层极淡底光 + 标题转金。深色底版，金色即它的强调色。
 *
 * 本轮只改本页渲染层；上方数据逻辑（projects / photosById / coverOf）
 * 一字未动，schema、后台、暗室页、碎片页均不受影响。
 */
const projects = (await getCollection('projects')).sort((a, b) =>
  String(b.data.date || '').localeCompare(String(a.data.date || '')),
);

// slug -> 照片条目。展线引用与 mdx 文件名可能带/不带扩展名，这里统一去扩展名建键
const photosById = new Map(
  (await getCollection('photos')).map((p) => [p.id.replace(/\.(mdx?|md)$/, ''), p]),
);

// 封面：优先后台设定；否则取展线第一张的真实 image 路径（不猜扩展名）
function coverOf(p: (typeof projects)[number]): string {
  if (p.data.cover) return p.data.cover;
  for (const ref of p.data.photos) {
    const e = photosById.get(ref.replace(/\.(mdx?|md)$/, ''));
    if (e?.data.image) return e.data.image;
  }
  return '';
}

// 缩略图条：展线前 3 张的真实图片路径（顺序即策展顺序的一部分）
function stripOf(p: (typeof projects)[number]): string[] {
  const out: string[] = [];
  if (p.data.cover) out.push(p.data.cover);
  for (const ref of p.data.photos) {
    const e = photosById.get(ref.replace(/\.(mdx?|md)$/, ''));
    const src = e?.data.image;
    if (src && !out.includes(src)) out.push(src);
    if (out.length >= 3) break;
  }
  return out;
}
---

<Layout
  title="专题 - SLOW 慢驶摄影画廊"
  description="精选策展区：从碎片中提炼的成体系创作，按策展顺序逐一观看。"
>
  <div class="h-24"></div>

  <div class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="section-title">专题</h1>
    <p class="text-gray-500 text-sm mt-3 mb-12">
      {projects.length > 0 ? `${projects.length} 个专题 · 点击进入暗室` : '策展会陆续在这里开始'}
    </p>

    {
      projects.length === 0 ? (
        <div class="py-24 text-center">
          <p class="text-gray-500 text-sm">
            还没有专题。在 /admin 后台「专题策展」里
            <br />
            给碎片区按顺序编册，这里就会亮起第一盏灯。
          </p>
        </div>
      ) : (
        <div class="work-list">
          {projects.map((p) => {
            const strip = stripOf(p);
            return (
              <a href={`/projects/${p.id}`} class="work-row group">
                <div class="w-left">
                  <h2 class="w-title">{p.data.title}</h2>
                  <span class="w-meta">
                    {p.data.photos.length} 张{p.data.date ? ` · ${p.data.date}` : ''}
                  </span>
                  {strip.length > 0 && (
                    <div class="w-strip">
                      {strip.map((src, i) => (
                        <img src={src} alt={i === 0 ? p.data.title : ''} loading="lazy" />
                      ))}
                    </div>
                  )}
                </div>
                <div class="w-right">
                  {p.data.summary ? (
                    <p class="w-blurb">{p.data.summary}</p>
                  ) : (
                    <span class="w-enter">进入暗室 →</span>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>

  <style>
    /* 社论行布局：图录式，黑金版 */
    .work-list {
      border-top: 1px solid rgb(255 255 255 / 0.16);
    }
    .work-row {
      display: grid;
      grid-template-columns: minmax(220px, 32%) 1fr;
      gap: clamp(20px, 4vw, 72px);
      padding: clamp(28px, 4vw, 52px) 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.1);
      align-items: start;
      transition: background-color 0.3s;
      text-decoration: none;
    }
    .work-row:hover {
      background: rgb(255 255 255 / 0.02);
    }
    .w-left {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .w-title {
      font-size: clamp(20px, 2.4vw, 34px);
      font-weight: 300;
      letter-spacing: 0.04em;
      line-height: 1.1;
      color: #e5e5e5;
      transition: color 0.3s;
    }
    .work-row:hover .w-title {
      color: #c9a558;
    }
    .w-meta {
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #6b7280;
    }
    /* 缩略条：展线前三张，发丝间距，微光过渡 */
    .w-strip {
      display: flex;
      gap: 6px;
      margin-top: 4px;
    }
    .w-strip img {
      width: 84px;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: 2px;
      opacity: 0.72;
      transition: opacity 0.35s;
    }
    .work-row:hover .w-strip img {
      opacity: 1;
    }
    .w-right {
      padding-top: 6px;
      min-width: 0;
    }
    .w-blurb {
      color: #a3a3a3;
      font-size: 14px;
      line-height: 1.9;
      max-width: 460px;
    }
    .w-enter {
      font-size: 12px;
      letter-spacing: 0.18em;
      color: #525252;
      transition: color 0.3s;
    }
    .work-row:hover .w-enter {
      color: #c9a558;
    }
    @media (max-width: 767px) {
      .work-row {
        grid-template-columns: 1fr;
        gap: 18px;
      }
    }
  </style>
</Layout>
