---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

/**
 * 专题（Projects）列表页 —— 2.0 轨道二的入口。
 * 零侵入：纯新增路由，不触碰首页/关于/联系/photos 任何现有页面。
 *
 * 版式移植自美术馆图录式（xuchenguo.com Work 页）的社论行布局：
 * 每个专题一行，左列标题+缩略图条，右列自述，发丝线分隔，
 * 悬停仅一层极淡底光 + 标题转金。深色底版，金色即它的强调色。
 *
 * 本轮只改本页渲染层；上方数据逻辑（projects / photosById / coverOf）
 * 一字未动，schema、后台、暗室页、碎片页均不受影响。
 */
const projects = (await getCollection('projects')).sort((a, b) =>
  String(b.data.date || '').localeCompare(String(a.data.date || '')),
);

// slug -> 照片条目。兼容两种清单格式：旧 p-016 / 新 /photos/p-016.jpg
const normKey = (ref) =>
  String(ref)
    .replace(/^\/?photos\//, '')
    .replace(/\.(mdx?|md|jpe?g|png|webp)$/i, '');
const photosById = new Map(
  (await getCollection('photos')).map((p) => [normKey(p.id), p]),
);

// 封面：优先后台设定；否则取展线第一张的真实 image 路径（不猜扩展名）
function coverOf(p: (typeof projects)[number]): string {
  if (p.data.cover) return p.data.cover;
  for (const ref of p.data.photos) {
    const e = photosById.get(normKey(ref));
    if (e?.data.image) return e.data.image;
  }
  return '';
}

// 构建期读图片头部取真实宽高比（纯 JS，零依赖）。失败回退 4:3。
import fs from 'node:fs';
import path from 'node:path';
const ratioCache = new Map();
function ratioOf(src) {
  if (ratioCache.has(src)) return ratioCache.get(src);
  let r = 1.333;
  try {
    const fp = path.join(process.cwd(), 'public', src.replace(/^\//, ''));
    const fd = fs.openSync(fp, 'r');
    // 读取窗口要够大：相机 JPEG 的 EXIF 段内嵌缩略图，SOF 常推到 70KB+ 之外
    const buf = Buffer.alloc(512 * 1024);
    const n = fs.readSync(fd, buf, 0, buf.length, 0);
    fs.closeSync(fd);
    if (buf[0] === 0xff && buf[1] === 0xd8) {
      // JPEG：扫 SOF 段
      let i = 2;
      while (i < n - 9) {
        if (buf[i] !== 0xff) { i++; continue; }
        const m = buf[i + 1];
        if (m >= 0xc0 && m <= 0xcf && m !== 0xc4 && m !== 0xc8 && m !== 0xcc) {
          r = buf.readUInt16BE(i + 7) / buf.readUInt16BE(i + 5);
          break;
        }
        if (m === 0xd8 || m === 0x01 || (m >= 0xd0 && m <= 0xd7)) { i += 2; continue; }
        i += 2 + buf.readUInt16BE(i + 2);
      }
    } else if (buf[0] === 0x89 && buf[1] === 0x50) {
      // PNG：IHDR 定长
      r = buf.readUInt32BE(16) / buf.readUInt32BE(20);
    }
    if (!Number.isFinite(r) || r <= 0 || r > 6) r = 1.333;
  } catch { /* 兜底 4:3 */ }
  ratioCache.set(src, r);
  return r;
}

// 组图墙：整条展线（src + 原始宽高比），等高瀑布流按真实比例占宽
function stripOf(p: (typeof projects)[number]): { src: string; r: number }[] {
  const out: { src: string; r: number }[] = [];
  const push = (src: string) => {
    if (!out.some((o) => o.src === src)) out.push({ src, r: ratioOf(src) });
  };
  if (p.data.cover) push(p.data.cover);
  for (const ref of p.data.photos) {
    const e = photosById.get(normKey(ref));
    if (e?.data.image) push(e.data.image);
  }
  return out;
}
---

<Layout
  title="专题 - SLOW 慢驶摄影画廊"
  description="精选策展区：从碎片中提炼的成体系创作，按策展顺序逐一观看。"
>
  <div class="h-24"></div>

  <div class="max-w-6xl mx-auto px-6 py-12">
    <h1 class="section-title">专题</h1>
    <p class="text-gray-500 text-sm mt-3 mb-12">
      {projects.length > 0 ? `${projects.length} 个专题 · 点击进入暗室` : '策展会陆续在这里开始'}
    </p>

    {
      projects.length === 0 ? (
        <div class="py-24 text-center">
          <p class="text-gray-500 text-sm">
            还没有专题。在 /admin 后台「专题策展」里
            <br />
            给碎片区按顺序编册，这里就会亮起第一盏灯。
          </p>
        </div>
      ) : (
        <div class="work-list">
          {projects.map((p) => {
            const strip = stripOf(p);
            return (
              <a href={`/projects/${p.id}`} class="work-row group">
                <div class="w-left">
                  <h2 class="w-title">{p.data.title}</h2>
                  <span class="w-meta">
                    {p.data.photos.length} 张{p.data.date ? ` · ${p.data.date}` : ''}
                  </span>
                  {p.data.summary && <p class="w-blurb">{p.data.summary}</p>}
                  {p.data.summaryEn && <p class="w-blurb-en">{p.data.summaryEn}</p>}
                  <span class="w-enter">进入暗室 →</span>
                </div>
                <div class="w-right">
                  <div class="w-grid">
                    {
                      strip.map((it) => (
                        <img
                          src={it.src}
                          alt={p.data.title}
                          loading="lazy"
                          style={`--ar:${it.r.toFixed(4)}`}
                        />
                      ))
                    }
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>

  <style>
    /* 社论行布局：左上中文、左下英文对照、右侧组图墙（参考站体例，黑金版） */
    .work-list {
      border-top: 1px solid rgb(255 255 255 / 0.16);
    }
    .work-row {
      display: grid;
      grid-template-columns: minmax(240px, 34%) 1fr;
      gap: clamp(20px, 4vw, 64px);
      padding: clamp(28px, 4vw, 52px) 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.1);
      align-items: start;
      transition: background-color 0.3s;
      text-decoration: none;
    }
    .work-row:hover {
      background: rgb(255 255 255 / 0.02);
    }
    .w-left {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .w-title {
      font-size: clamp(20px, 2.4vw, 34px);
      font-weight: 300;
      letter-spacing: 0.04em;
      line-height: 1.1;
      color: #e5e5e5;
      transition: color 0.3s;
    }
    .work-row:hover .w-title {
      color: #c9a558;
    }
    .w-meta {
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #6b7280;
    }
    .w-blurb {
      color: #a3a3a3;
      font-size: 14px;
      line-height: 1.9;
      max-width: 460px;
    }
    .w-blurb-en {
      color: #525252;
      font-size: 12px;
      line-height: 1.8;
      max-width: 460px;
    }
    .w-enter {
      font-size: 12px;
      letter-spacing: 0.18em;
      color: #525252;
      transition: color 0.3s;
      margin-top: 2px;
    }
    .work-row:hover .w-enter {
      color: #c9a558;
    }
    /* 右侧组图墙：等高瀑布流——高度固定，宽度=高度×真实宽高比，
       一行放不下自动换行；顺序严格从左到右（策展顺序不被列填充打乱） */
    .w-right {
      min-width: 0;
    }
    .w-grid {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      align-content: flex-start;
      gap: 6px;
    }
    .w-grid img {
      height: clamp(110px, 15vw, 168px);
      width: auto;
      aspect-ratio: var(--ar, 1.333);
      object-fit: cover;
      border-radius: 2px;
      opacity: 0.72;
      transition: opacity 0.35s;
    }
    .work-row:hover .w-grid img {
      opacity: 1;
    }
    @media (max-width: 767px) {
      .work-row {
        grid-template-columns: 1fr;
        gap: 18px;
      }
    }
  </style>
</Layout>
