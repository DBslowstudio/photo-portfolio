---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在 - 摄影作品集" description="访问的页面不存在。">
  <div class="h-24"></div>

  <section
    class="max-w-4xl mx-auto px-6 pb-24 flex flex-col items-center text-center min-h-[50vh] justify-center"
  >
    <p class="text-gray-600 text-7xl md:text-8xl font-light tracking-widest">
      404
    </p>
    <h1 class="section-title mt-6">这个页面不存在</h1>
    <p class="text-gray-400 mt-4">
      链接可能已失效，或者照片已被移除。
    </p>
    <a
      href="/"
      class="mt-10 inline-block border border-white text-white px-10 py-3 text-sm tracking-widest uppercase hover:bg-white hover:text-black transition-all duration-300"
    >
      返回作品
    </a>
  </section>
</Layout>
