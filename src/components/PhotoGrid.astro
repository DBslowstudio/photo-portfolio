---
interface Props {
  photos: CollectionEntry<'photos'>[];
}

const { photos } = Astro.props;
---

<section class="max-w-7xl mx-auto px-6 py-20">
  <h2 class="section-title mb-12">作品</h2>
  
  <!-- 给这个网格容器加上 id，方便客户端 JS 找到它 -->
  <div id="photo-grid-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {
      photos.map((entry) => (
        <a
          href={`/photos/${entry.id}`}
          class="group relative overflow-hidden aspect-[4/3] bg-dark-800"
        >
          <img
            src={entry.data.image}
            alt={entry.data.title}
            loading="lazy"
            width="1600"
            height="1200"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-all duration-500 flex items-end">
            <div class="p-5 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
              <h3 class="text-white text-lg font-light tracking-wide">
                {entry.data.title}
              </h3>
              {entry.data.location && (
                <p class="text-gray-300 text-sm mt-1">{entry.data.location}</p>
              )}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>

<!-- 客户端脚本：每次刷新页面时，在浏览器端重新打乱照片顺序 -->
<script>
  window.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('photo-grid-container');
    if (!grid) return;

    // 获取网格里的所有图片项（即 <a> 标签）
    const items = Array.from(grid.children);
    
    // Fisher-Yates 洗牌算法（在客户端执行，每次刷新都不同）
    for (let i = items.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [items[i], items[j]] = [items[j], items[i]];
    }

    // 清空原容器并按新顺序重新插入
    items.forEach(item => grid.appendChild(item));
  });
</script>