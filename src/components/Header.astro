---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const currentPath = Astro.url.pathname;

const navItems = [
  { label: '作品', href: '/' },
  { label: '关于', href: '/about' },
  { label: '联系', href: '/contact' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
>
  <nav class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
<a href="/" class="flex items-center" aria-label="返回首页">  
  <!-- 替换了原来的 Image 组件 -->
<img 
  src={logo.src} 
  alt="网站Logo" 
  class="h-8 w-auto max-w-full object-contain" 
/>
    </a>
    <ul class="hidden md:flex items-center gap-8">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', currentPath === item.href && 'text-white']}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button id="menu-toggle" class="md:hidden text-white" aria-label="菜单">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="hidden md:hidden bg-dark-900/95 backdrop-blur-sm px-6 pb-6"
  >
    {
      navItems.map((item) => (
        <a href={item.href} class="block py-3 nav-link border-b border-dark-700">
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<script>
  const header = document.getElementById('site-header');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 80) {
      header?.classList.add('bg-dark-900/90', 'backdrop-blur-md', 'shadow-lg');
    } else {
      header?.classList.remove('bg-dark-900/90', 'backdrop-blur-md', 'shadow-lg');
    }
  });

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
