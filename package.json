    "tailwindcss": "^4.3.3",
    "tinacms": "^3.13.0"
  },
  "allowScripts": {
    "esbuild": true,
    "better-sqlite3": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
